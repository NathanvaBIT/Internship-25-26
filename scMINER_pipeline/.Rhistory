col = as.factor(data$fracture),
pch = 19,
main = "MDS Plot (Euclidean distance)",
xlab = "Coordinate 1",
ylab = "Coordinate 2")
legend("topright",
legend = levels(as.factor(data$fracture)),
col = 1:2,
pch = 19)
