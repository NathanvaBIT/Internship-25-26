### scMINER pipeline - bacteria_all_genes_combined
### BF (biofilm) + P (planktonisch) dataset
### 7884 cellen x 2853 genen
library(scMINER)
library(Matrix)
library(ggplot2)
library(anndata)
# Since both datasets (BF and P) were already filtered, quality-controlled and
# normalised in Python (log1p-CPM values confirmed), and already concatenated
# into a single combined dataset, we skip the QC, filtration and normalisation steps.
# STEP 1: Load the combined dataset
# $X   → expression matrix (cells x genes): 7884 x 2853
# $obs → cell metadata (sample)
# $var → gene metadata (leeg, maar var_names bevat de gennamen)
adata_combined <- readInput_h5ad(h5ad_file = "./DATA/bacteria_all_genes_combined.h5ad")
# Prefix toevoegen op basis van sample kolom (bf_ of p_)
sample_labels <- adata_combined$obs$sample  # "bf" of "p"
cell_numbers  <- adata_combined$obs_names   # "68", "96", etc.
adata_combined$obs_names <- paste0(sample_labels, "_", cell_numbers)
# Verify
print(head(adata_combined$obs_names, 5))  # Moet bf_68, bf_96... tonen
# Extract and transpose: cells x genes → genes x cells (2853 x 7884)
# FIX: gebruik var_names ipv rownames(var) want var is leeg
combined_mtx <- as(t(adata_combined$X), "dgCMatrix")
rownames(combined_mtx) <- adata_combined$var_names   # ← 2853 gennamen (dnaA, gyrB...)
colnames(combined_mtx) <- adata_combined$obs_names   # ← 7884 celnamen (bf_68, p_96...)
print(dim(combined_mtx))  # verwacht: 2853 genen x 7884 cellen
# STEP 2: Create SparseEset object
cell_metadata <- as.data.frame(adata_combined$obs)
rownames(cell_metadata) <- adata_combined$obs_names  # ← zorg dat rijnamen matchen
combined.eset <- createSparseEset(input_matrix = combined_mtx,
cellData     = cell_metadata,
projectID    = "BaSSSh_bacteria",
addMetaData  = TRUE)
dim(combined.eset)          # verwacht: 2853 x 7884
head(pData(combined.eset))  # verify sample kolom aanwezig
# STEP 3: Export als MICA input file
generateMICAinput(input_eset  = combined.eset,
output_file = "./MICA/MICA_all_genes_Input.txt")
# STEP 5: Read MICA output terug in R
#error he cant find my combined.eset so whats wrong here?
combined.eset <- addMICAoutput(combined.eset,
mica_output_file = "./MICA_OUTPUT/clustering_UMAP_euclidean_20_4.0552.txt",
visual_method    = "umap")
ls()
# Celnamen in combined.eset
head(colnames(combined.eset))
# Celnamen in MICA output
mica_check <- read.table("./MICA_OUTPUT/clustering_UMAP_euclidean_20_4.0552.txt",
header = TRUE, sep = "\t", nrows = 5)
head(mica_check$ID)
expression <- as.data.frame(exprs(combined.eset))
### scMINER pipeline - bacteria_all_genes_combined
### BF (biofilm) + P (planktonisch) dataset
### 7884 cellen x 2853 genen
library(scMINER)
library(Matrix)
library(ggplot2)
library(anndata)
# Since both datasets (BF and P) were already filtered, quality-controlled and
# normalised in Python (log1p-CPM values confirmed), and already concatenated
# into a single combined dataset, we skip the QC, filtration and normalisation steps.
# STEP 1: Load the combined dataset
# $X   → expression matrix (cells x genes): 7884 x 2853
# $obs → cell metadata (sample)
# $var → gene metadata (leeg, maar var_names bevat de gennamen)
adata_combined <- readInput_h5ad(h5ad_file = "./DATA/bacteria_all_genes_combined.h5ad")
# Prefix toevoegen op basis van sample kolom (bf_ of p_)
sample_labels <- adata_combined$obs$sample  # "bf" of "p"
cell_numbers  <- adata_combined$obs_names   # "68", "96", etc.
adata_combined$obs_names <- paste0(sample_labels, "_", cell_numbers)
# Verify
print(head(adata_combined$obs_names, 5))  # Moet bf_68, bf_96... tonen
# Extract and transpose: cells x genes → genes x cells (2853 x 7884)
# FIX: gebruik var_names ipv rownames(var) want var is leeg
combined_mtx <- as(t(adata_combined$X), "dgCMatrix")
rownames(combined_mtx) <- adata_combined$var_names   # ← 2853 gennamen (dnaA, gyrB...)
colnames(combined_mtx) <- adata_combined$obs_names   # ← 7884 celnamen (bf_68, p_96...)
print(dim(combined_mtx))  # verwacht: 2853 genen x 7884 cellen
# STEP 2: Create SparseEset object
cell_metadata <- as.data.frame(adata_combined$obs)
rownames(cell_metadata) <- adata_combined$obs_names  # ← zorg dat rijnamen matchen
combined.eset <- createSparseEset(input_matrix = combined_mtx,
cellData     = cell_metadata,
projectID    = "BaSSSh_bacteria",
addMetaData  = TRUE)
dim(combined.eset)          # verwacht: 2853 x 7884
head(pData(combined.eset))  # verify sample kolom aanwezig
# STEP 3: Export als MICA input file
generateMICAinput(input_eset  = combined.eset,
output_file = "./MICA/MICA_all_genes_Input.txt")
View(cell_metadata)
