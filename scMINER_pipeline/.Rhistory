# Kleuren per fracture
frac_col <- ifelse(data$fracture == "fracture", "#FC8D62", "#66C2A5")
# Puntgrootte op basis van medicatie (3 groepen)
med_size <- as.numeric(as.factor(data$medication))
med_size <- med_size * 1.2  # 1.2 / 2.4 / 3.6 voor de 3 groepen
# Plot
plot(fit[,1], fit[,2],
col  = frac_col,
pch  = 19,
cex  = med_size,
main = "MDS Plot: fracture (kleur) + medicatie (grootte)",
xlab = "Coordinate 1",
ylab = "Coordinate 2")
# Legenda fracture
legend("topright",
legend = c("Fracture", "No fracture"),
col    = c("#FC8D62", "#66C2A5"),
pch    = 19,
pt.cex = 1.5,
title  = "Fracture")
# Legenda medicatie grootte
legend("bottomright",
legend = levels(as.factor(data$medication)),
col    = "gray40",
pch    = 19,
pt.cex = c(1.2, 2.4, 3.6),
title  = "Medicatie")
