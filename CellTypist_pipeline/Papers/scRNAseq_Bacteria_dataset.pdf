         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Proposed title(s):  Single-cell RNA sequencing of Staphylococcus aureus biofilm captures transcriptionally diverse subpopulations and differential responses to immune pressure  Bacterial single-cell RNA sequencing of biofilm captures diverse subpopulations and differential responses to immune pressure  Bacterial single-cell RNA sequencing captures biofilm transcriptional heterogeneity and immune-specific perturbations</rdf:li>
            </rdf:Alt>
         </dc:title>
         <xmp:CreateDate>2024-11-19T09:18:03+05:30</xmp:CreateDate>
